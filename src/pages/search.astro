---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Search — The Reel Vault" index={false}>
  <div class="section-head">
    <div><span class="kicker">Search the vault</span><h2 id="searchTitle">Search</h2></div>
  </div>
  <p class="type" id="searchCount" style="margin-top:-4px"></p>
  <div id="searchResults"></div>
  <div class="pager" id="searchPager"></div>
</BaseLayout>

<script>
  import { initSearch } from '../scripts/search'
  initSearch()
</script>
